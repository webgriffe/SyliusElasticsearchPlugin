{% set searchForm = get_search_form() %}

{% form_theme searchForm '@SyliusShop/form/theme.html.twig' %}

<div class="col d-none d-lg-block">

    {{ form_start(searchForm, {
        'attr': {
            'class': 'position-relative',
            'role': 'search',
            'data-instant-search': 'form',
        },
    }) }}

    {% hook 'form-group' %}

    {% hook 'results' %}

    {{ form_end(searchForm, {'render_rest': true}) }}

</div>

<div class="col-auto d-lg-none">
    <button
        class="btn btn-icon btn-transparent px-0"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mobileSearchBar"
        aria-expanded="false"
        aria-label="Search"
    >
        <svg viewBox="0 0 24 24" class="icon">
            <path fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"
                  d="M11 19a8 8 0 1 1 0-16a8 8 0 0 1 0 16Zm10 2-4.35-4.35"/>
        </svg>
    </button>
</div>
